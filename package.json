{
  "name": "vocal-studio-personal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, offline, single-user vocal and music learning studio with no npm dependencies",
  "scripts": {
    "check": "node tests/syntax-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python run.py",
    "verify": "python tests/verify.py",
    "test:browser": "python tests/browser_check.py",
    "test:build": "python tests/build_check.py",
    "test:portable": "python tests/portable_check.py",
    "test:visual": "python tests/visual_check.py",
    "test:media": "python tests/media_check.py",
    "package:portable": "python build_portable.py portable/VocalStudio.pyz"
  }
}
