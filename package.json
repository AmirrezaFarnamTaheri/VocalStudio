{
  "name": "vocal-studio-personal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, offline, single-user vocal and music learning studio with no npm dependencies",
  "scripts": {
    "check": "node tests/syntax-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 run.py",
    "test:portable": "python3 tests/portable_check.py",
    "test:visual": "python3 tests/visual_check.py",
    "test:media": "python3 tests/media_check.py",
    "package:portable": "python3 build_portable.py VocalStudio.pyz"
  }
}
